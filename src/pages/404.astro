---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 - Page Not Found | Urip Yoga Pangestu"
  description="The page you are looking for does not exist."
  noindex
>
  <main class="container mx-auto flex min-h-[70vh] flex-col items-center justify-center text-center">
    <h1 class="font-body text-6xl font-bold text-primary">404</h1>
    <p class="pt-4 font-body text-xl text-primary">
      Page not found.
    </p>
    <a
      href="/"
      class="pt-8 font-body text-lg font-medium text-secondary underline hover:text-green"
    >
      Back to home
    </a>
  </main>
</Layout>
