---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="CV - Urip Yoga Pangestu | Fullstack Software Engineer"
  description="CV & Resume Urip Yoga Pangestu - Result-driven Fullstack Software Engineer with expertise in Laravel 12/13, React.js, Tailwind CSS, DevOps (Linux, Nginx, Podman, Cloudflare), and AI API integration."
>
  <main id="main" class="relative">
    <!-- Download PDF Button -->
    <button
      id="download-pdf"
      class="fixed bottom-8 right-8 z-50 bg-secondary text-white p-4 rounded-full shadow-lg hover:bg-green transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-secondary"
      aria-label="Download CV as PDF"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
        ></path>
      </svg>
    </button>

    <div class="container mx-auto pdf-content">
      <!-- HEADER & SUMMARY -->
      <div class="border-b border-black py-4 lg:py-8 first-section">
        <div class="flex items-start gap-4">
          <img
            src="/me.png"
            class="w-24 h-24 md:hidden object-cover rounded-lg"
            alt="Urip Yoga Pangestu"
            width="96"
            height="96"
            loading="eager"
          />
          <div>
            <h1
              class="pt-2 font-body text-4xl font-semibold text-primary md:text-5xl lg:text-6xl"
            >
              Urip Yoga Pangestu
            </h1>
            <p class="font-body text-lg md:text-xl font-medium text-secondary pt-1">
              Fullstack Software Engineer
            </p>
          </div>
        </div>

        <div class="pt-4 border-b border-black pb-4">
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 text-sm md:text-base">
            <li>
              <a
                href="mailto:hello@pangestudev.web.id"
                class="hover:text-secondary transition-colors"
              >
                <span class="font-bold">email</span> : hello@pangestudev.web.id
              </a>
            </li>
            <li>
              <a
                href="https://pangestudev.web.id"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-secondary transition-colors"
              >
                <span class="font-bold">website</span> : pangestudev.web.id
              </a>
            </li>
            <li>
              <a
                href="https://linkedin.com/in/uripyogapangestu"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-secondary transition-colors"
              >
                <span class="font-bold">linkedin</span> : linkedin.com/in/uripyogapangestu
              </a>
            </li>
            <li>
              <a
                href="https://github.com/timurlauttt"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-secondary transition-colors"
              >
                <span class="font-bold">github</span> : github.com/timurlauttt
              </a>
            </li>
            <li>
              <a
                href="https://wa.me/6285861466287"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-secondary transition-colors"
              >
                <span class="font-bold">phone</span> : (+62) 858-6146-6287
              </a>
            </li>
            <li>
              <span class="font-bold">location</span> : Purwokerto, Indonesia
            </li>
          </ul>
        </div>

        <div class="pt-6">
          <h2 class="font-body text-2xl font-semibold text-primary">
            PROFESSIONAL SUMMARY
          </h2>
          <p
            class="pt-4 font-body text-base lg:text-lg font-light text-primary text-justify leading-relaxed"
          >
            Result-driven Fullstack Software Engineer with a proven track record of architecting, deploying, and maintaining high-performance web applications and institutional systems. Deep expertise in modern PHP (Laravel 12/13) and JavaScript (React.js) ecosystems, combined with robust DevOps capabilities in Linux, Nginx, and Podman environments. Demonstrated success in integrating third-party APIs (Midtrans, Google Gemini AI) and optimizing cloud infrastructure (Cloudflare ecosystem) to deliver secure, scalable, and automated digital solutions.
          </p>
        </div>
      </div>

      <!-- TECHNICAL SKILLS -->
      <div class="border-b border-black py-8 lg:py-12 skill-section">
        <div class="flex items-center pb-6">
          <h3 class="font-body text-2xl font-semibold text-primary">
            TECHNICAL SKILLS
