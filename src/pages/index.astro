            <h4 class="font-body text-lg font-semibold text-primary pb-2 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
              Frameworks & Libraries
            </h4>
            <p class="font-body font-light text-primary text-base">
              Laravel (v12, v13), React.js, Tailwind CSS (v4), Django, Bootstrap, Alpine.js, Blade.
            </p>
          </div>

          <!-- DevOps & Cloud -->
          <div class="border border-grey-light p-4 rounded-lg bg-grey-lightest/40">
            <h4 class="font-body text-lg font-semibold text-primary pb-2 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
              DevOps & Cloud
            </h4>
            <p class="font-body font-light text-primary text-base">
              Linux, Podman, Nginx, Cloudflare (R2 Storage, Pages), GitHub Actions, Vercel, cPanel, WebPush API, PWA.
            </p>
          </div>

          <!-- Database & Integrations -->
          <div class="border border-grey-light p-4 rounded-lg bg-grey-lightest/40">
            <h4 class="font-body text-lg font-semibold text-primary pb-2 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
              Database & Integrations
            </h4>
            <p class="font-body font-light text-primary text-base">
